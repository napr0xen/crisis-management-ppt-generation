# Copy to .env and fill in. Never commit .env.

# --- Docker Compose ---
POSTGRES_USER=doc_intel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=doc_intel
OPENWEBUI_IMAGE_TAG=v0.13.4
QDRANT_IMAGE_TAG=v1.20.2

# --- Backend (src/doc_intel/core/config.py) ---
DATABASE_URL=postgresql+asyncpg://doc_intel:change-me@127.0.0.1:5432/doc_intel
QDRANT_URL=http://127.0.0.1:6333
STORAGE_ROOT=./data/storage
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PIPE_SHARED_SECRET=
SIGNING_SECRET=
SIGNED_URL_TTL_S=900
LOG_LEVEL=INFO
