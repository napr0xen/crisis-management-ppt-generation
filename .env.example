# Copy to .env and fill in. Never commit .env.

# --- Docker Compose ---
POSTGRES_USER=doc_intel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=doc_intel
OPENWEBUI_IMAGE_TAG=v0.13.4
QDRANT_IMAGE_TAG=v1.20.2

# --- Backend (src/doc_intel/core/config.py) ---
DATABASE_URL=postgresql+asyncpg://doc_intel:change-me@127.0.0.1:5432/doc_intel
QDRANT_URL=http://127.0.0.1:6333
# Optional but recommended: Qdrant (via compose) and the backend both read it. Empty = no auth.
QDRANT_API_KEY=
STORAGE_ROOT=./data/storage
# Required, at least 32 characters (startup fails otherwise). Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PIPE_SHARED_SECRET=
SIGNING_SECRET=
SIGNED_URL_TTL_S=900
# Prefix of artifact download links handed to the Pipe.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Written into templates for missing / conflict fields; {label} is the field label.
MISSING_MARKER=[MISSING: {label}]
CONFLICT_MARKER=[CONFLICT: See Chat Summary]
LOG_LEVEL=INFO
MAX_UPLOAD_MB=100
CHUNK_MAX_TOKENS=512
# Dense embeddings come from Ollama (ADR-011); sparse BM25 vectors are computed locally.
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
# Hugging Face tokenizer used to size chunks (<= CHUNK_MAX_TOKENS).
CHUNK_TOKENIZER=Qwen/Qwen3-Embedding-0.6B
# 0 disables the in-process job worker; max 1 on 24 GB (ADR-010).
JOB_CONCURRENCY=1
# Generation (ADR-005). ollama: native API root (not /v1); openai_compat: any OpenAI-compatible
# /v1 root. For openai_compat, LLM_NUM_CTX must match the server's context (it is not sent).
# Faster on Apple silicon: serve the LLM with mlx_lm.server (embeddings stay on Ollama):
#   uv tool install mlx-lm
#   mlx_lm.server --model mlx-community/Qwen3-14B-4bit --host 127.0.0.1 --port 8080
# then set:
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=http://127.0.0.1:8080/v1
#   LLM_MODEL=mlx-community/Qwen3-14B-4bit
# LM Studio works the same way (its server is http://127.0.0.1:1234/v1).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:14b
# Low-RAM fallback: LLM_MODEL=qwen3:4b
LLM_API_KEY=
LLM_NUM_CTX=32768
LLM_TIMEOUT_SECONDS=120
LLM_ENABLE_THINKING=false
RERANKER_DEVICE=mps
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
QDRANT_COLLECTION=doc_chunks
