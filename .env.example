# Copy to .env and fill in. Never commit .env.

# --- Docker Compose ---
POSTGRES_USER=doc_intel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=doc_intel
OPENWEBUI_IMAGE_TAG=v0.13.4
QDRANT_IMAGE_TAG=v1.20.2

# --- Backend (src/doc_intel/core/config.py) ---
DATABASE_URL=postgresql+asyncpg://doc_intel:change-me@127.0.0.1:5432/doc_intel
QDRANT_URL=http://127.0.0.1:6333
STORAGE_ROOT=./data/storage
# Required, at least 32 characters (startup fails otherwise). Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PIPE_SHARED_SECRET=
SIGNING_SECRET=
SIGNED_URL_TTL_S=900
LOG_LEVEL=INFO
MAX_UPLOAD_MB=100
CHUNK_MAX_TOKENS=512
# Dense embeddings come from Ollama (ADR-011); sparse BM25 vectors are computed locally.
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
# Hugging Face tokenizer used to size chunks (<= CHUNK_MAX_TOKENS).
CHUNK_TOKENIZER=Qwen/Qwen3-Embedding-0.6B
# 0 disables the in-process job worker; max 1 on 24 GB (ADR-010).
JOB_CONCURRENCY=1
# Generation (ADR-005). ollama: native API root (not /v1); openai: any OpenAI-compatible /v1 root.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:14b
# Low-RAM fallback: LLM_MODEL=qwen3:4b
LLM_API_KEY=
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=120
LLM_ENABLE_THINKING=false
RERANKER_DEVICE=mps
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
QDRANT_COLLECTION=doc_chunks
