escription": "Name of the official media spokesperson.", "expected_type": "text", "required": true, "write_mode": "replace_text", "constraints": {}}, {"field_id": "next_update_date", "anchor_id": "a9", "section_path": ["Incident report"], "label": "Next update date", "description": "Date of the next public update.", "expected_type": "date", "required": true, "write_mode": "replace_text", "constraints": {}}]}, "sources": [{"filename": "utility_log.txt", "text": "Riverside Substation Fire\n\nA fire broke out at the Riverside Substation on 4 March 2025 and the power outage began at 02:10 that morning.\n\nDana Whitfield is the incident commander for the response.\n\nUtility control room count: 12,000 customers are without power.\n\nActions so far: crews isolated the damaged transformer; the fire brigade extinguished the blaze; mobile generators were deployed to the hospital."}, {"filename": "city_bulletin.txt", "text": "City Emergency Bulletin\n\nThe city emergency office reports that 15,000 customers are without power after the Riverside fire.\n\nResidents should avoid the Riverside industrial area while crews work."}], "expected": {"incident_title": {"status": "populated", "value": "Riverside Substation Fire"}, "outage_start": {"status": "populated", "value": "2025-03-04"}, "customers_affected": {"status": "conflict"}, "incident_commander": {"status": "populated", "value": "Dana Whitfield"}, "actions_taken": {"status": "populated", "value": ["isolated the damaged transformer", "extinguished the blaze", "mobile generators"]}, "estimated_cost": {"status": "missing"}, "injuries": {"status": "missing"}, "media_spokesperson": {"status": "missing"}, "next_update_date": {"status": "missing"}}}
